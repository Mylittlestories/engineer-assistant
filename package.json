{
  "name": "engineer-assistant",
  "private": true,
  "version": "2.4.0",
  "type": "module",
  "main": "electron/main.cjs",
  "bin": "dist/server.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build:web": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --external:vite --sourcemap --outfile=dist/server.cjs",
    "build:desktop": "npm run build:web && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --packages=bundle --sourcemap --outfile=dist/server.cjs",
    "build:pages": "npm run build:web && node scripts/create-pages-fallback.cjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server.cjs",
    "preview": "vite preview --host 0.0.0.0",
    "clean": "node scripts/clean.cjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "electron:dev": "npm run build:desktop && electron electron/main.cjs",
    "dist:win": "npm run build:desktop && electron-builder --win nsis portable --publish never",
    "dist:linux": "npm run build:desktop && electron-builder --linux AppImage deb --publish never",
    "dist:mac": "npm run build:desktop && electron-builder --mac dmg --universal --publish never",
    "pwa:build": "npm run build:pages",
    "android:add": "cap add android",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "cap open android",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:build:release": "npm run android:sync && cd android && ./gradlew assembleRelease",
    "dist:mac:x64": "npm run build:desktop && electron-builder --mac dmg --x64 --publish never",
    "dist:mac:arm64": "npm run build:desktop && electron-builder --mac dmg --arm64 --publish never",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "npm run lint && npm run test && npm run build:pages"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@google/genai": "^2.7.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "5.5.207",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.7",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@google/genai@2.7.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.0": true,
    "protobufjs@7.6.2": true
  },
  "productName": "Engineer Assistant",
  "description": "Refined mobile-first marine troubleshooting assistant with easy navigation, dedicated PDF manual vault, offline expert packs, Browser Gemini AI, safety/PTW, and desktop releases.",
  "author": {
    "name": "Mylittlestories",
    "email": "noreply@example.com"
  },
  "build": {
    "appId": "com.mylittlestories.engineerassistant",
    "productName": "Engineer Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Engineer-Assistant-${version}-${arch}.${ext}",
      "icon": "public/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Engineer-Assistant-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "Mylittlestories <noreply@example.com>",
      "artifactName": "Engineer-Assistant-${version}-${arch}.${ext}",
      "icon": "public/icons/icon-512.png",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.education",
      "artifactName": "Engineer-Assistant-${version}-${arch}.${ext}",
      "icon": "public/icons/icon.icns"
    },
    "asar": true,
    "compression": "maximum"
  },
  "homepage": "https://mylittlestories.github.io/engineer-assistant/",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "desktopName": "Engineer Assistant"
}
